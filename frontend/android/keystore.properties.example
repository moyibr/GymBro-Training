# Copy to android/keystore.properties and fill in — this file is git-ignored.
#
# Create the keystore once (JDK 21 required), then BACK IT UP somewhere you will still
# have in five years. Android refuses to install an update signed with a different key:
#
#   keytool -genkeypair -v -keystore gymbro-release.jks -alias gymbro \
#           -keyalg RSA -keysize 2048 -validity 10950
#
# storeFile is relative to frontend/android/ (or absolute).
storeFile=gymbro-release.jks
storePassword=CHANGE_ME
keyAlias=gymbro
keyPassword=CHANGE_ME
